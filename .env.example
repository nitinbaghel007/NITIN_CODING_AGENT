# ==============================================================
# Nitin Coding Agent - environment variables
#
# Local development: copy this file to `.env` (same folder) and
# fill in your own values. `main.py` loads `.env` automatically
# at startup, and values already exported in your shell always
# take precedence (they are never overridden).
#
# `.env` is git-ignored. This file contains PLACEHOLDERS ONLY -
# never commit real keys.
# ==============================================================

# --- OpenRouter -------------------------------------------------
# Used by: agent/providers/openrouter.py
# Default provider of the agent (registered first in the loop).
OPENROUTER_API_KEY=

# --- Google Gemini ----------------------------------------------
# Used by: agent/providers/gemini.py
# Fallback provider used during failover.
GEMINI_API_KEY=

# Optional. Overrides the Gemini model used for generation.
# Comment this line out (or delete it) to use the default:
# gemini-3.8-flash
GEMINI_MODEL=
