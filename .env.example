# ==============================================================
# Nitin Coding Agent - environment variables
#
# Copy this file to `.env` and fill in your own values, or export
# the variables in your shell. `.env` is git-ignored.
#
# This file contains PLACEHOLDERS ONLY. Never commit real keys.
# ==============================================================

# --- OpenRouter -------------------------------------------------
# Used by: agent/providers/openrouter.py
# Default provider of the agent (registered first in the loop).
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Google Gemini ----------------------------------------------
# Used by: agent/providers/gemini.py
# Fallback provider used during rate-limit failover.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Overrides the Gemini model used for generation.
# Defaults to: gemini-3.8-flash
GEMINI_MODEL=your-gemini-model-id-here
